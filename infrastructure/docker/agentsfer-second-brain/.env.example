# Safe local example only; keep the actual file private.
POSTGRES_DB=hindsight
POSTGRES_USER=hindsight
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
HINDSIGHT_DB_USER=hindsight_app
HINDSIGHT_DB_PASSWORD=REPLACE_WITH_URI_SAFE_SECRET
# Use a URI-safe secret matching HINDSIGHT_DB_PASSWORD.
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight_app:REPLACE_WITH_URI_SAFE_SECRET@postgres:5432/hindsight
HINDSIGHT_API_LLM_API_KEY=REPLACE_WITH_PROVIDER_KEY
HINDSIGHT_HOST_PORT=8888
