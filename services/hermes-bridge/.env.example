# Safe local template only. Never commit populated values.
HERMES_BRIDGE_TOKEN=
# Local-only example. Production must explicitly preserve the existing
# reverse-proxy-reachable interface; never use a wildcard bind.
HOST=127.0.0.1
PORT=8787
